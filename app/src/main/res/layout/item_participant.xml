<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <!-- Small Circular Avatar with user initials -->
    <androidx.cardview.widget.CardView
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/slate_200">
        
        <TextView
            android:id="@+id/tvPartAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/slate_800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="U"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textColor="@color/slate_900"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvPartEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="a.nguyen@example.com"
            android:textColor="@color/slate_500"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Validation Actions container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">

        <!-- Sleek Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmParticipant"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Xác nhận"
            android:textAllCaps="false"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            android:visibility="gone"/>

        <!-- Premium Confirmed Badge -->
        <TextView
            android:id="@+id/tvConfirmedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã hoàn thành"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/emerald_700"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/emerald_100"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
