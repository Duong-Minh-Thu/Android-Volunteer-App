<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SleekCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="true"
    app:strokeColor="@color/slate_200"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Header: Avatar, Creator/Org Name, Time Posted -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- Circular Avatar -->
            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary">
                
                <TextView
                    android:id="@+id/tvAvatarChar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="V"/>

                <ImageView
                    android:id="@+id/ivOrgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrgName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhà Tổ Chức"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPostedTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vừa xong"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Body: Campaign Title & Description -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="Tiêu đề chiến dịch tình nguyện"
            android:textColor="@color/slate_900"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDescShort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="Mô tả tóm tắt sự kiện..."
            android:textColor="@color/slate_800"
            android:textSize="13.5sp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="3"/>

        <!-- Event Image (16:9) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">
            
            <ImageView
                android:id="@+id/ivCampaign"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"/>

            <!-- Optional Date Badge Overlap -->
            <TextView
                android:id="@+id/tvEventTimeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#CC0F172A"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="11sp"
                android:text="25 May - 8:00 AM"/>
        </FrameLayout>


        <!-- Action Bar: Like, Join, Comment, Share buttons as gorgeous high-contrast pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center_vertical">

            <!-- Like Button Pill -->
            <LinearLayout
                android:id="@+id/btnLikeLayout"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivLikeIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_like_outline"
                    app:tint="@color/slate_500"/>

                <TextView
                    android:id="@+id/tvLikeBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/slate_500"
                    android:textStyle="bold"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <!-- Join Button Pill -->
            <LinearLayout
                android:id="@+id/btnJoinLayout"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivJoinIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="@color/slate_500"/>

                <TextView
                    android:id="@+id/tvJoinBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/slate_500"
                    android:textStyle="bold"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <!-- Comment Button Pill -->
            <LinearLayout
                android:id="@+id/btnCommentLayout"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCommentIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_comment_outline"
                    app:tint="@color/slate_500"/>

                <TextView
                    android:id="@+id/tvCommentBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/slate_500"
                    android:textStyle="bold"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <!-- Share Button Pill -->
            <LinearLayout
                android:id="@+id/btnShareLayout"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="@color/slate_500"/>


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
