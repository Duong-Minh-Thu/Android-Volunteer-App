<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SleekCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/slate_200"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Rank Column -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp">

            <!-- Circular Rank Background for Top 3 (Golden, Silver, Bronze) -->
            <View
                android:id="@+id/viewRankBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill_active"
                android:backgroundTint="#F59E0B"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvRankNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- User Avatar Char Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary"
            android:layout_marginEnd="12dp">
            
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvLeaderboardAvatarChar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="U"/>

                <ImageView
                    android:id="@+id/ivLeaderboardAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Name & Role -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeaderboardUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A"
                android:textColor="@color/slate_900"
                android:textSize="14.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvLeaderboardUserRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tình Nguyện Viên"
                android:textColor="@color/slate_500"
                android:textSize="11.5sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <!-- Points badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_inactive"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvLeaderboardPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ĐRL"
                android:textColor="@color/slate_500"
                android:textSize="10.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
