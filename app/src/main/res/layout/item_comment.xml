<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:gravity="start">

    <!-- Small Circular Avatar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCommentAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvCommentAvatarChar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="U"/>

            <ImageView
                android:id="@+id/ivCommentAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Comment Bubble, Action Links and Nested Replies Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Speech Bubble Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_comment_bubble"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvCommentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Người Dùng - Vai trò"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCommentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nội dung bình luận của người dùng..."
                android:textColor="@color/slate_800"
                android:textSize="13sp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Under-bubble row: relative time and action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvCommentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vừa xong"
                android:textColor="@color/slate_400"
                android:textSize="10sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="@color/slate_400"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tvReplyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phản hồi"
                android:textColor="@color/slate_500"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- Nested Replies List Container -->
        <LinearLayout
            android:id="@+id/layoutRepliesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
